# Auto detect text files and perform LF normalization
* text=auto

# Explicitly ensure Gradle wrapper and shell scripts use LF line endings
/gradlew text eol=lf
*.sh text eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.apk binary
*.aab binary
